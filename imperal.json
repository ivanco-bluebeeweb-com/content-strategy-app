{
  "manifest_schema_version": 3,
  "sdk_version": "5.9.13",
  "app_id": "content-strategy-app",
  "version": "0.1.0",
  "name": "Content Strategy",
  "description": "Plans what to write next for your sites. Discovers content opportunities from Google Search Console data, clusters them into topics, generates structured article briefs (with image requirements for downstream generation), and tracks each idea through an editorial queue from idea to published.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "content_strategy:read",
    "content_strategy:write"
  ],
  "tools": [
    {
      "name": "ping",
      "description": "Diagnostic health-check tool — echoes back a message.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "message": {
            "default": "",
            "description": "Optional message to echo back",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "PingParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "echo": {
            "default": "",
            "title": "Echo",
            "type": "string"
          }
        },
        "title": "PingResult",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "content-strategy-app"
    }
  ],
  "signals": [],
  "schedules": [],
  "required_scopes": [],
  "icon_size_bytes": 290,
  "lifecycle": {
    "health_check": {
      "interval_sec": 60
    }
  },
  "panels": [
    {
      "panel_id": "queue",
      "slot": "left",
      "title": "Editorial Queue",
      "tree": {},
      "icon": "📋",
      "refresh": "manual",
      "center_overlay": false
    }
  ]
}